#!/bin/sh
# MyClean pre-commit gate: build (type-check), format-check, lint and the test suite.
# Enable once per clone with: git config core.hooksPath .githooks  (docs/development.md)
# MYCLEAN_HOOK_PRESET selects the CMake preset (default: debug).
set -eu

root="$(git rev-parse --show-toplevel)"
exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$root/tools/dev/check.ps1" \
    -Preset "${MYCLEAN_HOOK_PRESET:-debug}"
